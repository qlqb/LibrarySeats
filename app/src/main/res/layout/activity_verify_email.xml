<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dmu_navy"
    android:orientation="vertical"
    tools:context=".VerifyEmailActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/title_app"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="80dp"
        android:paddingEnd="40dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_app"
            android:textColor="@color/dmu_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/title_verify"
            android:textColor="@color/dmu_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            tools:text="20241234@dongyang.ac.kr 로 인증 메일을 보냈어요." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerified"
            style="@style/DmuButton"
            android:layout_marginTop="32dp"
            android:text="@string/btn_verified" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResend"
            style="@style/DmuOutlinedButton"
            android:layout_marginTop="12dp"
            android:text="@string/btn_resend" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/dmu_navy"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOtherAccount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_other_account"
            android:textColor="@color/dmu_blue" />
    </LinearLayout>
</LinearLayout>
